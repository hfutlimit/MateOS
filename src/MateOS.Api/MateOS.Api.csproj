<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MateOS.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="StackExchange.Redis" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MateOS.Domain/MateOS.Domain.csproj" />
    <ProjectReference Include="../MateOS.Contracts/MateOS.Contracts.csproj" />
  </ItemGroup>

  <!--
    迁移 SQL 是 ops/postgres/migrations 下的**唯一副本**（不复制到项目目录，避免双份漂移）。
    以嵌入资源方式打包，部署时无需携带 ops 目录；LogicalName 让资源名稳定，
    不随仓库目录结构变化。
  -->
  <ItemGroup>
    <EmbeddedResource Include="../../ops/postgres/migrations/*.sql">
      <LogicalName>MateOS.Api.Persistence.Migrations.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
